{
  "name": "soma-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:clinical": "playwright test --config playwright.clinical.config.js",
    "test:database": "node --test tests/database/*.test.js",
    "test:integration": "playwright test --config playwright.integration.config.js",
    "test:staging:api": "node --test tests/staging/api.test.mjs",
    "test:staging:browser": "playwright test --config playwright.staging.config.js",
    "test:public": "node --test tests/public/site.test.js",
    "test:phase3": "playwright test --config playwright.phase3.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "^4.5.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "rollup": "npm:@rollup/wasm-node@^4.60.4",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
